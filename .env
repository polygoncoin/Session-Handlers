;
; PHP session related configs
;

; Session mode - 'File', 'MySql', 'PostgreSql', 'MongoDb', 'Redis', 'Memcached', 'Cookie'
SESSION_STORE_MODE='File'

; Session driver
SESSION_LIFETIME=3600
; Session storage
SESSION_STORE_PATH='session-files'
; Cookie settings
SESSION_COOKIE_NAME='PHPSESSID'
SESSION_COOKIE_PATH='/'
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE='Lax'

; Session encryption
; Value=base64_encode(openssl_random_pseudo_bytes(32))
SESSION_ENCRYPTION_PASS_PHRASE='H7OO2m3qe9pHyAHFiERlYJKnlTMtCJs9ZbGphX9NO/c='
; Value=base64_encode(openssl_random_pseudo_bytes(16))
SESSION_ENCRYPTION_IV='HnPG5az9Xaxam9G9tMuRaw='

; MySql container
SESSION_MYSQL_HOST='localhost'
SESSION_MYSQL_PORT=3306
SESSION_MYSQL_USER='root'
SESSION_MYSQL_PASSWORD='shames11'
SESSION_MYSQL_DB='db_session'
SESSION_MYSQL_TABLE='sessions'

; PostgreSql container
SESSION_PGSQL_HOST='localhost'
SESSION_PGSQL_PORT=3306
SESSION_PGSQL_USER='root'
SESSION_PGSQL_PASSWORD='shames11'
SESSION_PGSQL_DB='session_db'
SESSION_PGSQL_TABLE='session'

; MongoDb container
SESSION_MONGO_HOST='localhost'
SESSION_MONGO_PORT=3306
SESSION_MONGO_USER='root'
SESSION_MONGO_PASSWORD='shames11'
SESSION_MONGO_DB='session_db'
SESSION_MONGO_TABLE='session'

; Redis container
SESSION_REDIS_HOST='localhost'
SESSION_REDIS_PORT=6379
SESSION_REDIS_USER='kartik'
SESSION_REDIS_PASSWORD='shames11'
SESSION_REDIS_DB=0

; Memcached container
SESSION_MEMCACHED_HOST='localhost'
SESSION_MEMCACHED_PORT=11211

; Cookie container
SESSION_DATA_COOKIE_NAME='PHPSESSDATA'   ; For sessionMode Cookie
